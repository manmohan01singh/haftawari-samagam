# ── Haftawari Samagam — environment template ─────────────────────────
# Copy this file to ".env" and fill in YOUR values. Never commit ".env".
# All EXPO_PUBLIC_ values are public client keys by design; real security
# comes from Supabase Row Level Security, not from hiding these keys.
# The Supabase SERVICE-ROLE key must NEVER be put here or in the app.

# Supabase project URL — Supabase Dashboard → your project → Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — Supabase Dashboard → Settings → API → anon public key
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# YouTube Data API v3 key — Google Cloud Console → APIs & Services →
# Credentials → Create credentials → API key (enable "YouTube Data API v3"
# under APIs & Services → Library first). Read-only metadata use only.
EXPO_PUBLIC_YOUTUBE_API_KEY=

# Optional key pool: comma-separated keys, each from its OWN Google Cloud
# project (YouTube quota is granted per project — several keys in one
# project share one quota). When a key's daily quota is exhausted the app
# automatically moves to the next key. Overrides the single key above
# when set.
EXPO_PUBLIC_YOUTUBE_API_KEYS=
