{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.haftawarisamagam.app",
      "predictiveBackGestureEnabled": false
    },
    "description": "Haftawari and Amritvela kirtan samagams, scheduled and shared.",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.haftawarisamagam.app",
      "supportsTablet": true
    },
    "name": "Haftawari Samagam",
    "orientation": "portrait",
    "slug": "haftawari-samagam",
    "userInterfaceStyle": "automatic",
    "version": "1.0.0",
    "web": {
      "backgroundColor": "#FFFFFF",
      "bundler": "metro",
      "description": "Haftawari and Amritvela kirtan samagams, scheduled and shared.",
      "display": "standalone",
      "favicon": "./assets/favicon.png",
      "lang": "en",
      "name": "Haftawari Samagam",
      "shortName": "Haftawari",
      "themeColor": "#FFFFFF"
    },
    "plugins": [
      "expo-image",
      "./plugins/withPictureInPicture.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "baseUrl": "/haftawari-samagam"
    },
    "owner": "anti002gravity",
    "extra": {
      "eas": {
        "projectId": "209bd251-d8c1-4197-a180-c41dc79bb6e7"
      }
    }
  }
}