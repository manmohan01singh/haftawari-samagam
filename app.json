{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#640B19",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.haftawarisamagam.app",
      "predictiveBackGestureEnabled": false
    },
    "description": "Haftawari and Amritvela kirtan samagams, scheduled and shared.",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.haftawarisamagam.app",
      "supportsTablet": true
    },
    "name": "Haftawari Samagam",
    "orientation": "portrait",
    "slug": "haftawari-samagam",
    "userInterfaceStyle": "automatic",
    "version": "1.0.0",
    "web": {
      "backgroundColor": "#FFFFFF",
      "bundler": "metro",
      "description": "Haftawari and Amritvela kirtan samagams, scheduled and shared.",
      "display": "standalone",
      "favicon": "./assets/favicon.png",
      "lang": "en",
      "name": "Haftawari Samagam",
      "shortName": "Haftawari",
      "themeColor": "#FFFFFF"
    },
    "plugins": [
      "expo-image",
      "./plugins/withPictureInPicture.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0F0F0F"
          }
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/haftawari-samagam"
    }
  }
}
